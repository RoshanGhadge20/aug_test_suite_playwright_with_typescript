{
  "name": "augmont-test-suite",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "playwright test",
    "test:admin": "playwright test --project=admin",
    "test:customer": "playwright test --project=auth-setup --grep \"authenticate customer\" && playwright test --project=customer --no-deps",
    "test:business": "playwright test --project=business",
    "test:new-admin": "playwright test --project=new-admin",
    "test:api": "playwright test --project=api-backend --project=api-emi",
    "test:api:backend": "playwright test --project=api-backend",
    "test:api:emi": "playwright test --project=api-emi",
    "test:api:customer": "playwright test --project=api-backend tests/api/backend/customer",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:unit": "cross-env SKIP_ENV_VALIDATION=true vitest run",
    "test:unit:watch": "cross-env SKIP_ENV_VALIDATION=true vitest",
    "api:dev": "tsx watch src/api/index.ts",
    "api:start": "node dist/api/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "report:html": "playwright show-report reports/html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "nodemailer": "^9.0.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
