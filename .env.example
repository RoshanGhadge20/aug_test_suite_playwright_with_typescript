# ============================================================
# Default environment for runs with no explicit `env` parameter
# ============================================================
DEFAULT_ENV=test
# Optional: overrides DEFAULT_ENV for Playwright (e.g. uat for customer UAT + Chrome only)
# TARGET_ENV=uat

# ============================================================
# TEST environment
#
# Credentials: every login is OTP-based. Set the user's mobile number
# and the OTP that the test env accepts (often a fixed backdoor OTP
# like `1234` for test users).
# ============================================================
TEST_BASE_URL_ADMIN=https://ap.gfat.augmont.com
TEST_BASE_URL_CUSTOMER=https://cp.gfat.augmont.com
TEST_BASE_URL_BUSINESS=https://agent.gfat.augmont.com
TEST_BASE_URL_NEW_ADMIN=https://new-ap.gfat.augmont.com/
TEST_BASE_URL_BACKEND=https://gold-loan-backend-api.gfat.augmont.com/
TEST_BASE_URL_EMI=

TEST_ADMIN_USER_MOBILE=
TEST_ADMIN_USER_OTP=
TEST_CUSTOMER_USER_MOBILE=
TEST_CUSTOMER_USER_OTP=
TEST_BUSINESS_USER_MOBILE=
TEST_BUSINESS_USER_OTP=
TEST_NEW_ADMIN_USER_MOBILE=
TEST_NEW_ADMIN_USER_OTP=
TEST_BACKEND_USER_MOBILE=
TEST_BACKEND_USER_OTP=
TEST_EMI_USER_MOBILE=
TEST_EMI_USER_OTP=
# Shop checkout OTP only (TC_SHOP_* — mobile is same as CUSTOMER_USER_* login)
TEST_SHOP_USER_OTP=1234

# Admin role login credentials — mobile required for the active env; OTP defaults to 1234 (see ADMIN_OTP below)
TEST_ADMIN_APPRAISER_MOBILE=
TEST_ADMIN_BM_MOBILE=
TEST_ADMIN_OPS_MOBILE=
TEST_ADMIN_PARTNER_MOBILE=

# ============================================================
# UAT environment
# ============================================================
UAT_BASE_URL_ADMIN=
UAT_BASE_URL_CUSTOMER=https://cp.gfau.augmont.com/
UAT_BASE_URL_BUSINESS=
UAT_BASE_URL_NEW_ADMIN=
UAT_BASE_URL_BACKEND=https://gold-loan-backend-api.gfau.augmont.com/
UAT_BASE_URL_EMI=

UAT_ADMIN_USER_MOBILE=
UAT_ADMIN_USER_OTP=
UAT_CUSTOMER_USER_MOBILE=8141122222
UAT_CUSTOMER_USER_OTP=123456
# Shop checkout OTP only (TC_SHOP_* — mobile is same as CUSTOMER_USER_* login)
UAT_SHOP_USER_OTP=1234

# Admin role login credentials — mobile required for the active env; OTP defaults to 1234 (see ADMIN_OTP below)
UAT_ADMIN_APPRAISER_MOBILE=
UAT_ADMIN_BM_MOBILE=
UAT_ADMIN_OPS_MOBILE=
UAT_ADMIN_PARTNER_MOBILE=

UAT_BUSINESS_USER_MOBILE=
UAT_BUSINESS_USER_OTP=
UAT_NEW_ADMIN_USER_MOBILE=
UAT_NEW_ADMIN_USER_OTP=
UAT_BACKEND_USER_MOBILE=
UAT_BACKEND_USER_OTP=
UAT_EMI_USER_MOBILE=
UAT_EMI_USER_OTP=

# ============================================================
# Runtime flags
# ============================================================
HEADLESS=true

# ============================================================
# Admin credentials (shared)
# ============================================================
# ADMIN_OTP=1234   # optional; admin login OTP (defaults to 1234)

# ============================================================
# Runner API
# ============================================================
API_PORT=3000
API_KEY=change-me-before-deploy
LOG_LEVEL=info
