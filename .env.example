# ============================================================
# File Upload Paths (for KYC documents) — OPTIONAL
# ============================================================
# If configured, these files will be uploaded during KYC tests.
# If omitted, file uploads are skipped (test continues without error).
#
# Supported formats: JPG, PNG, PDF
# Path resolution: relative to project root (e.g., testdata/admin/documents/pan-sample.jpg)
# File size: recommended < 5MB per file
#
# Setup: Run `python testdata/admin/documents/create-test-images.py` or see
# testdata/admin/documents/README.md for manual setup instructions.
#
# Error handling: Missing files are logged with warnings and uploads are skipped gracefully.

TEST_PAN_CARD_PATH=testdata/admin/documents/pan-sample.jpg
TEST_AADHAAR_PATH=testdata/admin/documents/aadhaar-sample.png
TEST_SIGNATURE_PATH=testdata/admin/documents/singnature-sample.png
TEST_DOCUMENT_PATH=testdata/admin/documents/singnature-sample.pdf
TEST_DOCUMENT_PATH=testdata/admin/documents/image.png

UAT_PAN_CARD_PATH=testdata/admin/documents/pan-sample.jpg
UAT_AADHAAR_PATH=testdata/admin/documents/aadhaar-sample.png
UAT_SIGNATURE_PATH=testdata/admin/documents/singnature-sample.png
UAT_DOCUMENT_PATH=testdata/admin/documents/singnature-sample.pdf
UAT_DOCUMENT_PATH=testdata/admin/documents/image.png