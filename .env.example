# ============================================================
# Runtime flags
# ============================================================
HEADLESS=false
#UAT_ADMIN_APPRAISER_MOBILE=8990758890
# ============================================================
# Runner API
# ============================================================
API_PORT=3000
API_KEY=change-me-before-deploy
LOG_LEVEL=info

# Local placeholder — only the Express runner uses this; playwright test just needs it to pass env validation
API_KEY=local-dev-placeholder


