{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022","dom"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@config/*": ["./config/*"],
      "@pages/*": ["./pages/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@utils/*": ["./utils/*"],
      "@api/*": ["./src/api/*"],
      "@services/*": ["./api-services/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "pages/**/*", "fixtures/**/*", "flows/**/*", "api-services/**/*", "setup/**/*", "config/**/*", "utils/**/*", "test/**/*", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "reports", "storage"]
}
